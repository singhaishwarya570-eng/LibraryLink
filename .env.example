# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection
# Atlas URI: mongodb+srv://<username>:<password>@cluster0.mongodb.net/librarylink
# Local URI: mongodb://127.0.0.1:27017/librarylink
MONGODB_URI=mongodb://127.0.0.1:27017/librarylink

# Security
JWT_SECRET=your_jwt_secret_key_here
